{
  "name": "kafkito-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsr generate && tsc -b --noEmit",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:palette": "bash scripts/check-palette.sh",
    "check:strings": "bash scripts/check-strings.sh",
    "check:tokens": "bash scripts/check-tokens.sh",
    "check:routes": "bash scripts/check-route-orphans.sh",
    "check:dates": "bash scripts/check-date-format.sh",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-query": "^5.101.3",
    "@tanstack/react-router": "^1.170.18",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
